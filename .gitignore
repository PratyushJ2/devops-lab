# ============================
# Terraform
# ============================
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log
crash.*.log
.terraform.lock.hcl

# ============================
# Ansible
# ============================
*.retry
ansible/inventory.ini
!ansible/inventory.ini.example

# ============================
# SSH keys
# ============================
*.pem
*.ppk
id_rsa*
id_ed25519*
!*.pub

# ============================
# Python / app
# ============================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ============================
# Docker
# ============================
*.env
.env.*
!*.env.example

# ============================
# Secrets - if you ever add one of these, keep it out of git
# ============================
secrets.yml
vault_pass.txt
*.secret

# ============================
# OS
# ============================
.DS_Store
Thumbs.db

# ============================
# Editors
# ============================
.vscode/
.idea/
*.swp

# ============================
# Logs
# ============================
*.log