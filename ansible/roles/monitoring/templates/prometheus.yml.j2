global:
  scrape_interval: 15s

scrape_configs:
  # Prometheus scraping itself - lets you see Prometheus's own health
  # in its own dashboards.
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  # Host-level metrics: CPU, memory, disk, network.
  - job_name: "node_exporter"
    static_configs:
      - targets: ["localhost:9100"]

  # Application metrics: request rate, latency, status codes - exposed
  # by the prometheus-fastapi-instrumentator library in the app itself.
  - job_name: "app"
    static_configs:
      - targets: ["localhost:{{ app_container_port }}"]