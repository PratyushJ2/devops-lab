# Copy this file to secrets.yml (same folder) and set a real password.
# secrets.yml is gitignored - this .example file is the only one that
# gets committed, so anyone cloning the repo knows this variable exists
# and needs a value, without ever seeing a real password in git.
#
#   cp secrets.yml.example secrets.yml
#   # then edit secrets.yml with a real password

---
grafana_admin_password: "REPLACE_WITH_A_REAL_PASSWORD"